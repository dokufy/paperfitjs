{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "node", "promise", "vitest"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "error",
    "typescript/no-useless-empty-export": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**"]
}
